[Unit]
Description=Restricted four-tool Kolibre MCP staging bridge
After=network-online.target kolibre-stage.service
Wants=network-online.target kolibre-stage.service

[Service]
User=kolibre-mcp-stage
Group=kolibre-mcp-stage
WorkingDirectory=/opt/kolibre-mcp-stage/current
EnvironmentFile=/etc/kolibre-stage/bridge.env
ExecStart=/opt/kolibre-mcp-stage/current/.venv/bin/python -m calibre_mcp.kolibre_bridge
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
LogsDirectory=kolibre-mcp-stage
LogsDirectoryMode=0700
ReadWritePaths=/var/log/kolibre-mcp-stage
InaccessiblePaths=-/var/lib/docker -/var/lib/kolibre-stage -/root -/etc/ssh
MemoryMax=512M
CPUQuota=50%
TasksMax=96

[Install]
WantedBy=multi-user.target
