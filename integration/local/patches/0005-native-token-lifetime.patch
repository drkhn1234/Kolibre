From b70c168940686599a1ec8844ea60b0116c151b96 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 7 Nov 2026 13:31:08 +0300
Subject: [PATCH] feat(auth): configure bounded native access-token lifetime

---
 .env.example                                |  4 ++++
 backend/app/auth.py                         | 13 +++++++++++-
 backend/tests/test_native_token_lifetime.py | 22 +++++++++++++++++++++
 3 files changed, 38 insertions(+), 1 deletion(-)
 create mode 100644 backend/tests/test_native_token_lifetime.py

diff --git a/.env.example b/.env.example
index c4a3dc6..58754a6 100644
--- a/.env.example
+++ b/.env.example
@@ -36,6 +36,10 @@ ADMIN_PASSWORD=changeme
 # valid token for any account.
 #SECRET_KEY=
 
+# Native password-login token lifetime in minutes (integer 1..10080).
+# Defaults to seven days for compatibility; use a shorter lifetime for staging.
+#KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES=15
+
 # ── Which origins may talk to this server ─────────────────────────────────
 # By default only localhost, private networks (RFC1918) and .local names, on
 # any port. Set this only if you reach Kolibre through a domain name or a
diff --git a/backend/app/auth.py b/backend/app/auth.py
index e5f005e..392cac1 100644
--- a/backend/app/auth.py
+++ b/backend/app/auth.py
@@ -94,7 +94,18 @@ def _scegli_chiave() -> str:
 
 SECRET_KEY = _scegli_chiave()
 ALGORITHM = "HS256"
-ACCESS_TOKEN_EXPIRE_MINUTES = 60 * 24 * 7  # 7 days
+def _native_token_lifetime_minutes() -> int:
+    """Allow a shorter operator-selected lifetime without disabling expiry."""
+    try:
+        minutes = int(os.environ.get("KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES", "10080"))
+    except ValueError as exc:
+        raise ValueError("KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES must be an integer from 1 to 10080") from exc
+    if not 1 <= minutes <= 10080:
+        raise ValueError("KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES must be an integer from 1 to 10080")
+    return minutes
+
+
+ACCESS_TOKEN_EXPIRE_MINUTES = _native_token_lifetime_minutes()
 oauth2_scheme = OAuth2PasswordBearer(tokenUrl="token")
 oauth2_scheme_optional = OAuth2PasswordBearer(tokenUrl="token", auto_error=False)
 
diff --git a/backend/tests/test_native_token_lifetime.py b/backend/tests/test_native_token_lifetime.py
new file mode 100644
index 0000000..d93b5e6
--- /dev/null
+++ b/backend/tests/test_native_token_lifetime.py
@@ -0,0 +1,22 @@
+"""An operator can shorten native sessions; invalid policies fail closed."""
+import os
+import unittest
+from unittest.mock import patch
+
+from app import auth
+
+
+class NativeTokenLifetimeTests(unittest.TestCase):
+    def test_default_preserves_existing_sessions_and_operator_can_shorten(self):
+        with patch.dict(os.environ, {}, clear=True):
+            self.assertEqual(auth._native_token_lifetime_minutes(), 10080)
+        with patch.dict(os.environ, {"KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES": "15"}):
+            self.assertEqual(auth._native_token_lifetime_minutes(), 15)
+
+    def test_invalid_policy_cannot_remove_expiry_or_silently_fall_back(self):
+        for value in ("0", "-1", "10081", "", "forever", "1.5"):
+            with self.subTest(value=value), patch.dict(
+                os.environ, {"KOLIBRE_ACCESS_TOKEN_EXPIRE_MINUTES": value}
+            ):
+                with self.assertRaises(ValueError):
+                    auth._native_token_lifetime_minutes()
