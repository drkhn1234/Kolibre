From 60d0b39997a921b4fcc91cade97037e64edb3da2 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sat, 7 Nov 2026 21:02:49 +0300
Subject: [PATCH] Support atomic book vectors and precomputed authorized
 LanceDB queries

---
 src/calibre_mcp/rag/lancedb_vector_store.py | 54 +++++++++++++++++----
 tests/unit/test_lance_authorized_storage.py | 25 ++++++++++
 2 files changed, 70 insertions(+), 9 deletions(-)
 create mode 100644 tests/unit/test_lance_authorized_storage.py

diff --git a/src/calibre_mcp/rag/lancedb_vector_store.py b/src/calibre_mcp/rag/lancedb_vector_store.py
index d5256d7..1bef8f9 100644
--- a/src/calibre_mcp/rag/lancedb_vector_store.py
+++ b/src/calibre_mcp/rag/lancedb_vector_store.py
@@ -14,8 +14,6 @@ from typing import Any
 
 import lancedb
 
-from calibre_mcp.rag.fastembed_gpu import create_text_embedding, repo_root_from_here
-
 logger = logging.getLogger(__name__)
 
 
@@ -25,18 +23,21 @@ class LanceVectorStore:
     def __init__(
         self,
         db_path: str | Path,
-        embedding_model_name: str = "BAAI/bge-small-en-v1.5",
+        embedding_model_name: str | None = "BAAI/bge-small-en-v1.5",
         table_name: str = "documents",
     ) -> None:
         self.db_path = Path(db_path)
         self.db_path.parent.mkdir(parents=True, exist_ok=True)
         self.db = lancedb.connect(str(self.db_path))
-        cache_dir = str(self.db_path / "cache")
-        self.embedding_model, self.embed_device, self.embed_batch_size = create_text_embedding(
-            embedding_model_name,
-            cache_dir,
-            repo_root=repo_root_from_here(),
-        )
+        if embedding_model_name is not None:
+            from calibre_mcp.rag.fastembed_gpu import create_text_embedding, repo_root_from_here
+
+            cache_dir = str(self.db_path / "cache")
+            self.embedding_model, self.embed_device, self.embed_batch_size = create_text_embedding(
+                embedding_model_name,
+                cache_dir,
+                repo_root=repo_root_from_here(),
+            )
         self.table_name = table_name
 
     def add_documents(self, documents: list[dict[str, Any]], overwrite: bool = True) -> None:
@@ -100,3 +101,38 @@ class LanceVectorStore:
 
         tbl = self.db.open_table(self.table_name)
         return {"exists": True, "row_count": tbl.count_rows()}
+
+    def replace_book_vectors(self, book_id: int, rows: list[dict[str, Any]]) -> None:
+        """Atomically replace one book; caller owns embeddings and authorization."""
+        book_id = int(book_id)
+        if not rows:
+            if self.table_name in self.db.table_names():
+                self.db.open_table(self.table_name).delete(f"metadata.book_id = {book_id}")
+            return
+        if any(int(r["metadata"]["book_id"]) != book_id for r in rows):
+            raise ValueError("Mixed-book replacement")
+        if self.table_name not in self.db.table_names():
+            self.db.create_table(self.table_name, data=rows)
+            return
+        table = self.db.open_table(self.table_name)
+        (
+            table.merge_insert("id")
+            .when_matched_update_all()
+            .when_not_matched_insert_all()
+            .when_not_matched_by_source_delete(f"metadata.book_id = {book_id}")
+            .execute(rows)
+        )
+
+    def search_vector(self, vector: list[float], *, where: str, limit: int = 100) -> list[dict[str, Any]]:
+        """Precomputed query, mandatory caller-built prefilter. No identity inference."""
+        if not where or self.table_name not in self.db.table_names():
+            return []
+        table = self.db.open_table(self.table_name)
+        return (
+            table.search(vector)
+            .distance_type("cosine")
+            .where(where, prefilter=True)
+            .limit(limit)
+            .to_arrow()
+            .to_pylist()
+        )
diff --git a/tests/unit/test_lance_authorized_storage.py b/tests/unit/test_lance_authorized_storage.py
new file mode 100644
index 0000000..c27a72f
--- /dev/null
+++ b/tests/unit/test_lance_authorized_storage.py
@@ -0,0 +1,25 @@
+"""Actual LanceDB updates, using externally generated vectors, no model download."""
+
+from calibre_mcp.rag.lancedb_vector_store import LanceVectorStore
+
+
+def row(book, text, vector):
+    return {
+        "id": str(book),
+        "content": text,
+        "vector": vector,
+        "metadata": {"book_id": book, "digest": "version", "section": "c.xhtml", "word_start": 0},
+    }
+
+
+def test_atomic_book_replacement_and_prefilter(tmp_path):
+    store = LanceVectorStore(tmp_path / "lance", embedding_model_name=None)
+    store.replace_book_vectors(1, [row(1, "old", [1.0, 0.0])])
+    store.replace_book_vectors(2, [row(2, "other", [0.0, 1.0])])
+    store.replace_book_vectors(1, [row(1, "new", [1.0, 0.0])])
+    result = store.search_vector([1.0, 0.0], where="metadata.book_id = 1")
+    assert [r["content"] for r in result] == ["new"]
+    assert store.get_table_metadata()["row_count"] == 2
+    store.replace_book_vectors(1, [])
+    assert not store.search_vector([1.0, 0.0], where="metadata.book_id = 1")
+    assert store.search_vector([1.0, 0.0], where="metadata.book_id = 2")[0]["content"] == "other"
